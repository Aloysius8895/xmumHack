/* Wisp's guided tour (sources/Career/CareerTour.js): ghost portrait + speech box at the bottom left, toy block theme */

.career-tour {
    position: absolute;
    left: calc(24px + env(safe-area-inset-left));
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 7;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    width: 600px;
    max-width: calc(100vw - 48px);
    font-family: var(--font-body, inherit);
    color: var(--text, #2A1F6E);
    pointer-events: none;
    opacity: 0;
    transform: translateY(24px);
    visibility: hidden;
    transition: opacity 0.3s, transform 0.3s cubic-bezier(0.34, 1.3, 0.64, 1), visibility 0s linear 0.3s;
}

.career-tour.is-visible {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition: opacity 0.3s, transform 0.3s cubic-bezier(0.34, 1.3, 0.64, 1);
}

.career-tour-ghost {
    flex-shrink: 0;
    width: 120px;
    margin-bottom: 18px;
    animation: career-tour-float 2.6s ease-in-out infinite;
    filter: drop-shadow(0 6px 0 rgba(42, 31, 110, 0.25));
}

.career-tour-ghost svg {
    display: block;
    width: 100%;
    height: auto;
}

.career-tour-ghost-body,
.career-tour-ghost-arm {
    fill: #FFFFFF;
    stroke: var(--outline, #3B2E9E);
    stroke-width: 3;
    stroke-linejoin: round;
}

.career-tour-ghost-eye,
.career-tour-ghost-mouth {
    fill: none;
    stroke: var(--outline, #3B2E9E);
    stroke-width: 3.2;
    stroke-linecap: round;
}

.career-tour-ghost-blush {
    fill: #FF9FC4;
}

.career-tour-ghost-hat {
    fill: #3D4FD6;
    stroke: var(--outline, #3B2E9E);
    stroke-width: 3;
    stroke-linejoin: round;
}

.career-tour-ghost-band {
    fill: #FFFFFF;
    stroke: var(--outline, #3B2E9E);
    stroke-width: 2;
}

.career-tour-ghost-star {
    fill: #FFD84A;
}

.career-tour-box {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 26px 20px 14px;
    border: 3px solid var(--outline, #3B2E9E);
    border-radius: 22px;
    background: var(--face-white, #FFFFFF);
    box-shadow: 0 6px 0 var(--extrude, #6A55E0);
    pointer-events: auto;
}

/* Speaker tab, like the mentors' dialogue box */
.career-tour-name {
    position: absolute;
    top: -16px;
    left: 18px;
    padding: 3px 14px;
    border: 3px solid var(--outline, #3B2E9E);
    border-radius: 12px;
    background: var(--amber, #FFB547);
    font-family: var(--font-heading, inherit);
    font-size: 17px;
    font-weight: 700;
}

.career-tour-text {
    min-height: 3.2em;
    margin: 0 0 12px;
    font-size: 18px;
    line-height: 1.55;
    cursor: pointer;
}

.career-tour-footer {
    display: flex;
    align-items: center;
    gap: 12px;
}

.career-tour-progress {
    margin-right: auto;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted, #5A4FA0);
}

.career-tour-waiting {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-text, #6A2BB0);
    animation: career-tour-blink 1.4s ease-in-out infinite;
}

.career-tour-skip {
    padding: 4px 6px;
    border: 0;
    background: none;
    color: var(--text-muted, #5A4FA0);
    font-size: 15px;
    text-decoration: underline;
}

.career-tour-next {
    min-height: 44px;
    padding: 8px 20px;
    border: 3px solid var(--outline, #3B2E9E);
    border-radius: 14px;
    background: var(--amber, #FFB547);
    box-shadow: 0 4px 0 var(--outline, #3B2E9E);
    color: var(--text, #2A1F6E);
    font-size: 17px;
    font-weight: 700;
    transition: var(--toy-press);
}

.career-tour-next:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--outline, #3B2E9E);
}

.career-tour [hidden] {
    display: none;
}

/* The menu button the current step asks for glows (CareerTour sets data-tour-target on .career-ui) */
.career-ui[data-tour-target="profile"] .career-rail-item[data-panel="profile"],
.career-ui[data-tour-target="careers"] .career-rail-item[data-panel="careers"],
.career-ui[data-tour-target="pet"] .career-rail-item[data-panel="pet"],
.career-ui[data-tour-target="roadmap"] .career-rail-item[data-panel="roadmap"],
.career-ui[data-tour-target="log"] .career-rail-item[data-panel="log"] {
    animation: career-tour-glow 1.2s ease-in-out infinite;
}

@keyframes career-tour-float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-10px) rotate(3deg); }
}

@keyframes career-tour-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
}

@keyframes career-tour-glow {
    0%, 100% { background: var(--amber-soft, #FFE1A8); box-shadow: 0 0 0 0 rgba(255, 181, 71, 0.9); }
    50% { background: var(--amber, #FFB547); box-shadow: 0 0 0 8px rgba(255, 181, 71, 0); }
}

@media (max-width: 640px) {
    .career-tour-ghost {
        width: 72px;
    }

    .career-tour-text {
        font-size: 16px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .career-tour,
    .career-tour-ghost,
    .career-tour-waiting,
    .career-ui[data-tour-target] .career-rail-item {
        animation: none;
        transition: none;
    }
}

/* Placed next to the element to press (CareerTour.update sets left / top) */
.career-tour.is-placed {
    position: fixed;
    bottom: auto;
    z-index: 12;
    transition: left 0.35s cubic-bezier(0.34, 1.2, 0.64, 1), top 0.35s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.3s;
}

/* Dims the whole screen except a rounded hole on the element to press, clicks go through */
.career-tour-spot {
    position: fixed;
    z-index: 11;
    border-radius: 16px;
    box-shadow: 0 0 0 200vmax rgba(20, 12, 60, 0.6), 0 0 0 4px var(--amber, #FFB547), 0 0 24px 6px rgba(255, 181, 71, 0.7);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: left 0.3s ease, top 0.3s ease, width 0.3s ease, height 0.3s ease, opacity 0.3s, visibility 0s linear 0.3s;
}

.career-tour-spot.is-visible {
    opacity: 1;
    visibility: visible;
    transition: left 0.3s ease, top 0.3s ease, width 0.3s ease, height 0.3s ease, opacity 0.3s;
}

.career-tour-pointer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 13;
    width: 40px;
    pointer-events: none;
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.2s;
}

.career-tour-pointer.is-visible {
    opacity: 1;
}

.career-tour-pointer svg {
    display: block;
    width: 100%;
    fill: #FFFFFF;
    stroke: var(--outline, #3B2E9E);
    stroke-width: 2.2;
    stroke-linejoin: round;
    filter: drop-shadow(0 3px 0 rgba(42, 31, 110, 0.35));
    animation: career-tour-tap 1s ease-in-out infinite;
}

@keyframes career-tour-tap {
    0%, 100% { transform: translate(10px, 12px) scale(1); }
    45% { transform: translate(0, 0) scale(0.9); }
    55% { transform: translate(0, 0) scale(0.9); }
}

@media (prefers-reduced-motion: reduce) {
    .career-tour-pointer svg {
        animation: none;
    }

    .career-tour.is-placed,
    .career-tour-spot {
        transition: none;
    }
}

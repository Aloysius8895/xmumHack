{
  "name": "careersphere-market-crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env src/cli.js demo",
    "crawl": "node --env-file-if-exists=.env src/cli.js crawl",
    "start": "node --env-file-if-exists=.env src/cli.js serve",
    "summary": "node --env-file-if-exists=.env src/cli.js summary",
    "export": "node --env-file-if-exists=.env src/cli.js export",
    "push": "node --env-file-if-exists=.env src/cli.js push",
    "test": "node --test",
    "test:browser": "node --test browser-tests/dynamic.js",
    "browser:install": "playwright install chromium",
    "config:game": "node src/game-config.js",
    "setup:game": "node src/setup-game.js",
    "game:serve": "node --env-file-if-exists=.env src/game-cli.js serve",
    "game:crawl": "node --env-file-if-exists=.env src/game-cli.js crawl",
    "game:sync": "node --env-file-if-exists=.env src/game-cli.js sync",
    "game:push": "node --env-file-if-exists=.env src/game-cli.js push",
    "n8n:build": "node n8n/build-workflow.js",
    "browser:check": "node src/browser-probe.js",
    "browser:open": "node --env-file-if-exists=.env src/open-browser.js",
    "jsearch:check": "node --env-file-if-exists=.env src/check-jsearch.js"
  },
  "optionalDependencies": {
    "playwright": "1.62.1"
  }
}

modules = ["nodejs-22", "python-base-3.13"]
run = "cd src/game && npm run dev"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
exposeLocalhost = true

[deployment]
# The crawler needs no npm install in the cloud (its only dependency, Playwright, is for browser sources, which are off).
# beautifulsoup4 is only used when there is no JSearch key and LinkedIn public pages are read directly.
build = ["sh", "-c", "cd src/game && npm install && npm run build && (pip install -q beautifulsoup4 || true)"]
run = ["sh", "-c", "cd src/game && HOST=0.0.0.0 PORT=5000 npm run server:cloud"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd src/game && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
AI_PROVIDER = "deepseek"
AI_MOCK = "0"
DEEPSEEK_MODEL = "deepseek-flash"

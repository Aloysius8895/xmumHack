# .replit for a Repl of the game imported from the whole GitHub repo (the root .replit runs the chat bot).
# In that Repl's Shell: cp GamePlat/game/replit-repo-root.replit .replit
# Same commands as GamePlat/game/.replit, run from GamePlat/game.
modules = ["nodejs-22"]
run = "cd GamePlat/game && npm run dev"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[deployment]
build = ["sh", "-c", "cd GamePlat/game && npm install && npm run build"]
run = ["sh", "-c", "cd GamePlat/game && HOST=0.0.0.0 PORT=5000 npm run server"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd GamePlat/game && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
AI_PROVIDER = "deepseek"
AI_MOCK = "0"
DEEPSEEK_MODEL = "deepseek-flash"

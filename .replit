# Runs the chat bot service in chatbot/ (the rest of the repo is untouched).
run = "cd chatbot && pip install -q -r requirements.txt && python run.py"
modules = ["python-3.11"]

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
run = ["sh", "-c", "cd chatbot && PYTHONPATH=.deps python run.py"]
build = ["sh", "-c", "cd chatbot && PIP_USER=0 python -m pip install --target .deps -r requirements.txt"]
deploymentTarget = "gce"
ignorePorts = false

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chatbot"

[[workflows.workflow]]
name = "Chatbot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd chatbot && python run.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["cacert"]

# Runs the WhatsApp chat service in whatsapp/ (the rest of the repo is untouched).
run = "cd whatsapp && pip install -q -r requirements.txt && python run.py"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
run = ["sh", "-c", "cd whatsapp && pip install -q -r requirements.txt && python run.py"]

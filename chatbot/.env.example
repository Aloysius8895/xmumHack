# Put these in Replit Secrets. Never commit real values.

# Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > App settings > Basic > App secret (not the access token)
WHATSAPP_APP_SECRET=
# Any random string you choose; enter the same value in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=

# AI: with Replit AI Integrations enabled, Replit sets these for you (no key needed):
#   AI_INTEGRATIONS_ANTHROPIC_API_KEY / AI_INTEGRATIONS_ANTHROPIC_BASE_URL
#   AI_INTEGRATIONS_OPENAI_API_KEY    / AI_INTEGRATIONS_OPENAI_BASE_URL
# Optional overrides:
# AI_PROVIDER=anthropic        # or openai
# AI_MODEL=claude-haiku-4-5    # any model your provider offers on Replit
# HISTORY_TURNS=20             # past messages the AI sees per user
# WHATSAPP_DRY_RUN=true        # don't send to WhatsApp (auto-on when no token)

# CareerSphere game app (teammate's integration API)
CAREERSPHERE_API_URL=
# Bearer token for the CareerSphere integration API (never commit the real value)
INTEGRATION_TOKEN=
# Comma-separated WhatsApp numbers allowed to log reports. Empty/unset = no restriction (local testing).
ALLOWED_WA_IDS=
# Shared secret for POST /internal/digest/run (header X-Cron-Token)
CRON_TOKEN=
# Run the daily digest in-process at 23:30 Asia/Kuala_Lumpur. See README: Replit
# Autoscale may sleep and skip it - prefer a Reserved VM or an external cron for the demo.
DIGEST_SCHEDULE_ENABLED=false

# Telegram (demo channel while the WhatsApp Business account awaits Meta's company
# verification). Create a bot with @BotFather, then copy its token here.
TELEGRAM_BOT_TOKEN=
# Any random string you choose; registered as secret_token via scripts/set_telegram_webhook.py,
# and checked against header X-Telegram-Bot-Api-Secret-Token on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user ids allowed to log reports. Empty/unset = no restriction
# (local testing). Message the bot /start to see your own id.
TELEGRAM_ALLOWED_USER_IDS=

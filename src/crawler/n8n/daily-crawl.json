{
  "name": "CareerSphere - Daily incremental collection through the game",
  "nodes": [
    {
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "schedule",
      "name": "Every Day 08:00 MYT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "start",
      "name": "Start scheduled collection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xmum-hackfinal.replit.app/api/integrations/crawl/schedule",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "wait",
      "name": "Wait 10 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        470,
        80
      ],
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      }
    },
    {
      "id": "poll",
      "name": "Check collection and publication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://xmum-hackfinal.replit.app/api/integrations/crawl/schedule/' + $('Start scheduled collection').first().json.runId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "check",
      "name": "Verify final publication",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        930,
        80
      ],
      "parameters": {
        "jsCode": "const run=$input.first().json;\nif($runIndex>=75)throw new Error('Collection did not finish and publish within the polling budget');\nif(run.status==='failed')throw new Error('Collection/publication failed: '+(run.error||'unknown'));\nreturn [{json:{...run,pending:run.status!=='published'}}];"
      }
    },
    {
      "id": "pending",
      "name": "Still working?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1160,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-pending",
              "leftValue": "={{ $json.pending }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Start scheduled collection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Day 08:00 MYT": {
      "main": [
        [
          {
            "node": "Start scheduled collection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start scheduled collection": {
      "main": [
        [
          {
            "node": "Wait 10 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 seconds": {
      "main": [
        [
          {
            "node": "Check collection and publication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check collection and publication": {
      "main": [
        [
          {
            "node": "Verify final publication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify final publication": {
      "main": [
        [
          {
            "node": "Still working?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still working?": {
      "main": [
        [
          {
            "node": "Wait 10 seconds",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Kuala_Lumpur",
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}

/* Shared fantasy board. Illustration is decoration; every label and control is live HTML. */
.fantasy-exhibit-frame,
.fantasy-exhibit-brand {
    display: none;
}

.career-ui.is-fantasy-exhibit {
    --text: #21145b;
    --text-muted: #65538a;
    --career-muted: #65538a;
    --accent-text: #4820be;
    --face: #fff9ec;
    --face-white: #fffdf7;
    --face-soft: #f2e4fa;
    --outline: #8859cb;
    --line-soft: #dfcaec;
    --extrude-soft: #c7a7e0;
    --placeholder: #81719b;
    --career-ink: #21145b;
    --career-text: #21145b;
    --career-accent: #7638e8;
    --career-pink: #7638e8;
    --career-pink-strong: #5420c7;
    --career-pink-soft: #eee0fb;
    --career-pink-ink: #4b209a;
    --amber-soft: #ffe0ab;
    --on-dark: #ffffff;
    --toy-border: 1px solid #d8bde7;
    color: var(--text);
}

.career-ui.is-fantasy-exhibit::before {
    display: none;
}

.career-ui.is-fantasy-exhibit .building-exhibit-controls {
    display: block;
    z-index: 4;
    pointer-events: none;
}

.career-ui.is-fantasy-exhibit .building-exhibit-exit,
.career-ui.is-fantasy-exhibit .building-exhibit-hit:not([data-action="building-room"]) {
    display: none;
}

.career-ui.is-fantasy-exhibit .building-exhibit-hit[data-action="building-room"] {
    display: block;
    pointer-events: auto;
}

.career-ui.is-fantasy-exhibit .career-panel.is-building-screen {
    display: block;
    z-index: 2;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
    color: var(--text);
    font-size: 15px;
    isolation: isolate;
    --exhibit-text-size: clamp(14px, calc(var(--exhibit-width) * 0.0145), 19px);
}

.career-ui.is-fantasy-exhibit .fantasy-exhibit-frame {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 16px 28px #10051e80);
}

.career-ui.is-fantasy-exhibit .is-building-screen .career-panel-header {
    display: flex;
    position: absolute;
    left: 32%;
    top: 4.2%;
    width: 36%;
    height: 15%;
    z-index: 4;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 0 10px;
    min-height: 0;
    border: 0;
    background: transparent;
    color: #1a0960;
    text-align: center;
}

.career-ui.is-fantasy-exhibit .career-panel-header h2 {
    display: block;
    max-width: 100%;
    margin: 0;
    color: #1a0960;
    font-size: clamp(23px, calc(var(--exhibit-width) * 0.030), 44px);
    font-weight: 900;
    line-height: 1.12;
    text-wrap: balance;
    text-shadow: 0 2px 0 #fff6;
}

.career-ui.is-fantasy-exhibit .career-panel-header h2::before,
.career-ui.is-fantasy-exhibit .building-screen-brand {
    display: none;
}

.career-ui.is-fantasy-exhibit .fantasy-exhibit-brand {
    display: block;
    margin-top: 5px;
    color: #211059;
    font-size: clamp(11px, calc(var(--exhibit-width) * 0.014), 20px);
    font-weight: 750;
    white-space: nowrap;
}

.career-ui.is-fantasy-exhibit .career-close {
    position: absolute;
    top: 15%;
    left: 153%;
    display: grid;
    place-items: center;
    width: clamp(42px, calc(var(--exhibit-width) * 0.042), 60px);
    height: clamp(42px, calc(var(--exhibit-width) * 0.042), 60px);
    min-width: 42px;
    padding: 0;
    margin: 0;
    border: 3px solid #d0a5ff;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #fff3ff, #c7a2ff 65%, #9465e7);
    box-shadow: 0 4px 0 #381278, inset 0 0 0 2px #fff9, 0 0 14px #aa66f966;
    color: #6424cf !important;
    font-size: clamp(28px, calc(var(--exhibit-width) * 0.034), 46px);
    font-weight: 700;
    line-height: 1;
}

.career-ui.is-fantasy-exhibit .is-building-screen .career-panel-body {
    position: absolute;
    left: 17.1%;
    top: 21%;
    width: 65.8%;
    height: 63.7%;
    z-index: 2;
    padding: 18px 20px;
    border: 1px solid #e6c8e9;
    border-radius: 4px;
    background: radial-gradient(ellipse at 20% 0%, #fffdf6, transparent 70%),
        linear-gradient(135deg, #f5e8f7, #eddef8 45%, #e5cef2);
    color: var(--text);
    font-size: var(--exhibit-text-size);
    line-height: 1.55;
    scrollbar-width: thin;
    scrollbar-color: #9170bd #f7eaff;
    overflow: auto;
    overscroll-behavior: contain;
    scroll-padding: 16px;
}

.career-ui.is-fantasy-exhibit .career-panel-body::-webkit-scrollbar { width: 10px; height: 10px; }
.career-ui.is-fantasy-exhibit .career-panel-body::-webkit-scrollbar-track { background: #f5e9ff; border-radius: 20px; }
.career-ui.is-fantasy-exhibit .career-panel-body::-webkit-scrollbar-thumb { background: #9570bf; border: 2px solid #f5e9ff; border-radius: 20px; }

.career-ui.is-fantasy-exhibit .building-screen-sections {
    display: flex;
    position: absolute;
    left: 18.5%;
    top: 22%;
    z-index: 4;
    width: 63%;
    height: 5.5%;
    min-height: 34px;
    max-height: none;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    scrollbar-width: thin;
}

.career-ui.is-fantasy-exhibit .building-screen-sections:empty { display: none; }

.career-ui.is-fantasy-exhibit .building-screen-sections button {
    flex: 1 0 auto;
    max-width: none;
    min-height: 32px;
    height: 90%;
    padding: 4px 12px;
    border: 1px solid #c69ce9;
    border-radius: 9px;
    background: linear-gradient(#f9edff, #e7cff7);
    color: #351083;
    font-size: clamp(12px, calc(var(--exhibit-width) * 0.013), 17px);
    font-weight: 750;
    box-shadow: inset 0 1px 0 #fff, 0 3px 0 #b48bc8;
}

.career-ui.is-fantasy-exhibit .building-screen-sections button:hover {
    background: linear-gradient(#8246f3, #5420d1);
    color: #fff;
}

.career-ui.is-fantasy-exhibit .is-building-screen:has(.building-screen-sections:not(:empty)) .career-panel-body {
    top: 28.5%;
    height: 56.2%;
}

.career-ui.is-fantasy-exhibit .building-screen-footer {
    display: flex;
    position: absolute;
    z-index: 4;
    left: 26%;
    top: 85%;
    width: 48%;
    height: 5%;
    padding: 0;
    gap: 12px;
    justify-content: space-between;
    border: 0;
    background: transparent;
    color: #f6e3ff;
    font-size: clamp(11px, calc(var(--exhibit-width) * 0.012), 16px);
    line-height: 1.2;
}

.career-ui.is-fantasy-exhibit .exhibit-room-button {
    min-height: 30px;
    max-width: 42%;
    padding: 3px 8px;
    border: 0;
    border-radius: 8px;
    background: #54278380;
    color: #fff0ce;
    font-size: inherit;
    font-weight: 750;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.career-ui.is-fantasy-exhibit .building-screen-hint { display: none; }

.career-ui.is-fantasy-exhibit .exhibit-page-button {
    flex: 0 0 28px;
    min-height: 30px;
    padding: 0;
    border: 1px solid #c492f3;
    border-radius: 7px;
    background: #4b1a8f;
    color: #fff0cc;
    font-size: 22px;
    line-height: 1;
}

.career-ui.is-fantasy-exhibit .career-panel-body h3 {
    color: #201062;
    margin: 18px 0 12px;
    font-size: 1.3em;
    line-height: 1.25;
    font-weight: 850;
}

.career-ui.is-fantasy-exhibit .career-panel-body h4,
.career-ui.is-fantasy-exhibit .career-panel-body strong {
    color: #241164;
}

.career-ui.is-fantasy-exhibit .career-card,
.career-ui.is-fantasy-exhibit .career-skill-card,
.career-ui.is-fantasy-exhibit .career-trend-card,
.career-ui.is-fantasy-exhibit .career-notice,
.career-ui.is-fantasy-exhibit .career-trend-sampling,
.career-ui.is-fantasy-exhibit .career-sampling,
.career-ui.is-fantasy-exhibit .career-pet-card,
.career-ui.is-fantasy-exhibit .career-learning {
    position: relative;
    margin-bottom: 14px;
    padding: 16px 18px;
    border: 1px solid #e2c5df;
    border-left: 3px solid #cb9bd2;
    border-radius: 8px 15px 8px 15px;
    background: radial-gradient(ellipse at 10% 0%, #fffdf8, transparent 80%),
        linear-gradient(110deg, #fff5df, #fffaf0 55%, #ffedcf);
    box-shadow: inset 0 1px 0 #fff, 0 4px 0 #b28ac52b, 0 5px 12px #5a25601a;
}

.career-ui.is-fantasy-exhibit .career-notice.is-error { border-left-color: #c94c6c; }
.career-ui.is-fantasy-exhibit .career-notice.is-warning { border-left-color: #e5a133; }

.career-ui.is-fantasy-exhibit .career-trend-card::after {
    content: '';
    position: absolute;
    top: 10px;
    right: 12px;
    width: 12px;
    height: 14px;
    clip-path: polygon(50% 0, 95% 25%, 95% 75%, 50% 100%, 5% 75%, 5% 25%);
    background: linear-gradient(140deg, #ffeeb4 12%, #ffb62d 45%, #c46c0e 90%);
    pointer-events: none;
}

.career-ui.is-fantasy-exhibit .career-learning summary {
    color: #28105f;
    font-weight: 750;
    cursor: pointer;
}

.career-ui.is-fantasy-exhibit .career-learning > summary {
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid #ead5dd;
    font-size: 1.1em;
}

.career-ui.is-fantasy-exhibit .career-button,
.career-ui.is-fantasy-exhibit .career-trend-tab.is-active {
    min-height: 40px;
    padding: 9px 16px;
    border: 1px solid #9954ff;
    border-radius: 10px;
    background: linear-gradient(175deg, #7135fb, #491ad8 70%, #3c13ba);
    color: #fff !important;
    font-size: inherit;
    font-weight: 750;
    line-height: 1.3;
    box-shadow: inset 0 2px 0 #c39aff99, 0 3px 0 #441580, 0 5px 8px #571d9829;
    transition: filter 0.15s, transform 0.15s;
}

.career-ui.is-fantasy-exhibit .career-button:hover { filter: brightness(1.1); }
.career-ui.is-fantasy-exhibit .career-button:active { transform: translateY(2px); box-shadow: inset 0 2px 0 #c39aff66, 0 1px 0 #441580; }

.career-ui.is-fantasy-exhibit .career-button.is-secondary,
.career-ui.is-fantasy-exhibit .career-file-button,
.career-ui.is-fantasy-exhibit .career-trend-tab {
    border: 1px solid #c9a6e5;
    border-radius: 10px;
    background: linear-gradient(#f8ebff, #e7d2f6);
    color: #351286 !important;
    font-size: inherit;
    font-weight: 700;
    box-shadow: inset 0 2px 0 #fffc, 0 3px 0 #b68ccc;
}

.career-ui.is-fantasy-exhibit .career-panel-body input,
.career-ui.is-fantasy-exhibit .career-panel-body textarea,
.career-ui.is-fantasy-exhibit .career-panel-body select {
    min-width: 0;
    max-width: 100%;
    min-height: 40px;
    padding: 9px 12px;
    border: 1px solid #bc96e3;
    border-radius: 9px;
    background: linear-gradient(#fffdfa, #fff9f3);
    color: #281564;
    font-size: inherit;
    line-height: 1.4;
    box-shadow: inset 0 2px 3px #6c3c8b08;
}

.career-ui.is-fantasy-exhibit .career-panel-body input::placeholder,
.career-ui.is-fantasy-exhibit .career-panel-body textarea::placeholder { color: #8c77a8; }

.career-ui.is-fantasy-exhibit .career-trend-tabs {
    display: flex;
    gap: 7px;
    padding: 5px;
    background: #e6d1f4;
    border: 1px solid #d7b9eb;
    border-radius: 11px;
    overflow-x: auto;
}

.career-ui.is-fantasy-exhibit .career-trend-tab { min-height: 42px; padding: 9px 14px; }
.career-ui.is-fantasy-exhibit .career-trend-tab.is-active {
    background: linear-gradient(175deg, #7135fb, #491ad8 70%, #3c13ba);
    border-color: #9954ff;
    color: #fff !important;
    box-shadow: inset 0 2px 0 #c39aff99, 0 3px 0 #441580;
}

.career-ui.is-fantasy-exhibit .career-trend-search {
    margin-bottom: 14px;
    border: 1px solid #bf98e9;
    border-radius: 9px;
    background: #fffaf1;
    color: #5326be;
    box-shadow: inset 0 1px 0 #fff;
}

.career-ui.is-fantasy-exhibit .career-trend-search input[type="search"] {
    border: 0;
    background: transparent;
    box-shadow: none;
}

.career-ui.is-fantasy-exhibit .career-heatmap {
    font-size: 0.95em;
    border-spacing: 4px;
}

.career-ui.is-fantasy-exhibit .career-heatmap td { padding: 9px 7px; border-radius: 6px; }
.career-ui.is-fantasy-exhibit .career-heatmap thead th.is-latest { background: #ffdfab; color: #613010; }
.career-ui.is-fantasy-exhibit .career-sampling-toggle { color: #281264; font-size: inherit; }
.career-ui.is-fantasy-exhibit .career-muted,
.career-ui.is-fantasy-exhibit .career-trend-intro { color: #65538a; }
.career-ui.is-fantasy-exhibit :focus-visible { outline: 3px solid #e6a32f; outline-offset: 3px; }
.career-ui.is-fantasy-exhibit button:disabled { opacity: 0.55; }

@media (max-width: 699px) {
    .career-ui.is-fantasy-exhibit .career-panel.is-building-screen { --exhibit-text-size: 14px; }
    .career-ui.is-fantasy-exhibit .is-building-screen .career-panel-header { left: 29%; width: 42%; }
    .career-ui.is-fantasy-exhibit .career-panel-header h2 { font-size: 22px; }
    .career-ui.is-fantasy-exhibit .fantasy-exhibit-brand { font-size: 9px; white-space: normal; }
    .career-ui.is-fantasy-exhibit .career-close { left: 130%; top: 25%; min-width: 40px; width: 40px; height: 40px; }
    .career-ui.is-fantasy-exhibit .is-building-screen .career-panel-body { padding: 12px 10px; }
    .career-ui.is-fantasy-exhibit .career-card,
    .career-ui.is-fantasy-exhibit .career-notice,
    .career-ui.is-fantasy-exhibit .career-learning,
    .career-ui.is-fantasy-exhibit .career-trend-card { padding: 12px 10px; }
    .career-ui.is-fantasy-exhibit .career-button { padding: 8px 10px; white-space: normal; }
    .career-ui.is-fantasy-exhibit .career-actions { flex-wrap: wrap; }
    .career-ui.is-fantasy-exhibit .building-screen-footer { left: 18%; width: 64%; gap: 4px; }
}

@media (prefers-reduced-motion: reduce) {
    .career-ui.is-fantasy-exhibit .career-button { transition: none; }
}

/* World-space exhibition screens. Keep the existing career content and controls intact. */
.building-only {
    display: none;
}

.career-ui.is-building-view .building-only {
    display: flex;
}

.is-building-visit .career-minimap,
.career-ui.is-building-view .career-hud {
    display: none;
}

/* The top bar stays in buildings, centered above the exhibit (CareerUI fitBar keeps it clear of the zoom and exit
   buttons, BuildingScreen keeps its height free of the board) rather than sliding beside a side panel */
.career-ui.is-building-view .career-panel.is-open ~ .career-menu.is-bar .career-rail {
    left: var(--career-bar-center, 50%);
    transform: translateX(-50%);
}

.career-ui.is-building-view .career-panel.is-open ~ .career-menu.is-bar:not(.is-compact) .career-rail-item span {
    display: inline;
}

/* Navigation steps need their real menu target even while the exhibit is open. */
.career-ui.is-building-view.is-touring[data-tour-target] .career-menu {
    display: block;
    z-index: 6;
}

.career-ui .career-panel.is-building-screen {
    position: absolute;
    inset: auto;
    left: 0;
    top: 0;
    right: auto;
    bottom: auto;
    max-width: none;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #100d18;
    box-shadow: none;
    transform-origin: 0 0;
    transition: opacity 0.3s ease, visibility 0s;
    overflow: visible;
    opacity: 0;
    font-size: 17px;
    will-change: transform;
}

.career-ui .career-panel.is-building-screen.is-open {
    opacity: 1;
}

.career-ui.is-building-entering .career-panel.is-building-screen {
    opacity: 0;
    pointer-events: none;
}

.career-ui .is-building-screen .career-panel-header {
    position: relative;
    flex: 0 0 auto;
    gap: 12px;
    padding: 18px 24px;
    min-height: 72px;
    border: 0;
    border-bottom: 2px solid #765bff;
    border-radius: 0;
    background: #211835;
    color: #fff;
}

.career-ui .is-building-screen .career-panel-header h2 {
    display: block;
    margin: 0;
    font-size: 27px;
    color: #fff;
}

.career-ui .is-building-screen .career-panel-header h2::before {
    display: none;
}

.building-screen-brand {
    flex: 0 0 auto;
    gap: 12px;
    align-items: center;
    color: #d5c4ff;
    font-weight: 900;
    font-size: 22px;
}

.building-screen-brand span {
    color: #765bff;
}

.career-ui .is-building-screen .career-close {
    margin-left: auto;
    flex: 0 0 auto;
    color: #302052;
}

.building-screen-sections {
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    max-height: 70px;
    overflow-x: auto;
    border-bottom: 1px solid #493767;
    background: #191325;
    scrollbar-width: thin;
}

.career-ui.is-building-view .building-screen-sections:empty {
    display: none;
}

.building-screen-sections button {
    flex: 0 0 auto;
    max-width: 300px;
    padding: 6px 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border: 1px solid #8e74d8;
    border-radius: 8px;
    background: #302146;
    color: #ede4ff;
}

.building-screen-sections button:hover,
.building-screen-sections button:focus-visible {
    background: #765bff;
    color: #fff;
}

.career-ui .is-building-screen .career-panel-body {
    flex: 1 1 0;
    min-height: 0;
    margin: 0;
    padding: 24px 30px;
    overflow: auto;
    overscroll-behavior: contain;
    scroll-padding-top: 24px;
    border: 0;
    border-radius: 0;
    background: #f3eeff;
    box-shadow: none;
    animation: none;
}

.career-ui .is-building-screen .career-panel-body > :first-child {
    margin-top: 0;
}

.building-screen-footer {
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 22px;
    height: 48px;
    border-top: 2px solid #765bff;
    background: #211835;
    color: #d5c4ff;
    font-size: 15px;
}

.building-screen-hint {
    color: #ac9acb;
}

.building-screen-arrow {
    position: absolute;
    top: 45%;
    width: 50px;
    height: 52px;
    border: 2px solid #d5c4ff;
    border-radius: 10px;
    background: #765bff;
    color: #fff !important;
    box-shadow: 0 7px 0 #39246e;
    font-size: 32px !important;
    line-height: 1;
    transition: background 0.15s, box-shadow 0.15s;
}

.building-screen-arrow:first-child { left: -70px; }
.building-screen-arrow:last-child { right: -70px; }
.building-screen-arrow:hover { background: #967bff; }
.building-screen-arrow:active { box-shadow: 0 2px 0 #39246e; }

.career-ui .is-building-screen .career-map {
    min-height: 430px;
}

@media (prefers-reduced-motion: reduce) {
    .career-ui .career-panel.is-building-screen { transition: none; }
}

/* Original workshop furniture owns the frame, title, arrows and pagination. */
.career-ui.is-workshop-exhibit .career-panel-header,
.career-ui.is-workshop-exhibit .building-screen-footer,
.career-ui.is-workshop-exhibit:not(.is-fantasy-exhibit):not(.is-plain-board) .exhibit-room-nav {
    display: none;
}

.career-ui.is-workshop-exhibit .career-panel.is-building-screen {
    font-size: 19px;
}

.career-ui.is-workshop-exhibit .is-building-screen .career-panel-body {
    padding: 18px 22px;
}

.career-ui.is-workshop-exhibit .building-screen-sections {
    padding: 8px 12px;
    font-size: 15px;
    max-height: 54px;
}

.building-exhibit-controls {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
}

.building-exhibit-hit {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    pointer-events: auto;
    cursor: pointer;
}

.building-exhibit-hit:hover {
    box-shadow: inset 0 0 0 2px rgba(225, 210, 255, 0.6);
}

.building-exhibit-hit:focus-visible {
    outline: 3px solid #dccaff;
    outline-offset: 3px;
}

.building-exhibit-actions {
    position: absolute;
    top: unquote("max(18px, env(safe-area-inset-top))");
    right: unquote("max(18px, env(safe-area-inset-right))");
    display: flex;
    gap: 10px;
}

.building-exhibit-zoom {
    display: grid;
    place-items: center;
    width: 50px;
    border: 2px solid #bba5ff;
    border-radius: 10px;
    color: #fff !important;
    background: #302052;
    box-shadow: 0 4px 0 #171020;
    pointer-events: auto;
}

.building-exhibit-zoom svg,
.career-zoom svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
}

.building-exhibit-zoom:hover { background: #473078; }

.building-exhibit-exit {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 16px;
    border: 2px solid #bba5ff;
    border-radius: 10px;
    color: #fff !important;
    background: #302052;
    box-shadow: 0 4px 0 #171020;
    pointer-events: auto;
}

.building-exhibit-exit span { font-size: 24px; line-height: 1; }

/* Flat, legible exhibit typography; scoped so the rest of the game keeps its styling. */
.career-ui.is-workshop-exhibit {
    --font-body: Arial, "Noto Sans SC", "Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
    --font-heading: var(--font-body);
    --text: #231b32;
    --text-muted: #51495f;
    --accent-text: #5127a8;
    --placeholder: #696173;
    --face: #ffffff;
    --face-white: #ffffff;
    --face-soft: #f1edf8;
    --outline: #6942ad;
    --line-soft: #d8d1e2;
    --extrude-soft: #e4dced;
    --toy-border: 1px solid #d8d1e2;
    --career-muted: #51495f;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    line-height: 1.6;
}

.career-ui.is-workshop-exhibit::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(12, 8, 22, 0.24);
    pointer-events: none;
}

.career-ui.is-workshop-exhibit .is-building-screen .career-panel-body {
    padding: 16px 24px;
    background: #ffffff;
    color: #231b32;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    border-radius: 0;
}

.career-ui.is-workshop-exhibit .career-panel-body h3 {
    margin: 24px 0 14px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
    color: #231b32;
}

.career-ui.is-workshop-exhibit h2,
.career-ui.is-workshop-exhibit h3,
.career-ui.is-workshop-exhibit h4,
.career-ui.is-workshop-exhibit strong,
.career-ui.is-workshop-exhibit button {
    font-family: var(--font-body);
    text-shadow: none;
    letter-spacing: 0;
}

.career-ui.is-workshop-exhibit .building-screen-sections {
    gap: 8px;
    padding: 12px 20px;
    max-height: 70px;
    background: #21172f;
    border-bottom: 1px solid #493b5b;
    font-size: 16px;
}

.career-ui.is-workshop-exhibit .building-screen-sections button {
    min-height: 38px;
    padding: 6px 14px;
    border-color: #a68bca;
    border-radius: 6px;
    background: #352546;
    color: #ffffff;
    font-weight: 500;
}

.career-ui.is-workshop-exhibit .career-button,
.career-ui.is-workshop-exhibit .career-trend-tab.is-active {
    background: #6031b5;
    border-color: #6031b5;
    color: #ffffff !important;
    box-shadow: none;
}

.career-ui.is-workshop-exhibit .career-button:hover,
.career-ui.is-workshop-exhibit .career-trend-tab.is-active:hover {
    background: #48218e;
}

.career-ui.is-workshop-exhibit .career-button.is-secondary,
.career-ui.is-workshop-exhibit .career-file-button {
    background: #f1edf8;
    color: #3c2167 !important;
    border-color: #c7b6df;
    box-shadow: none;
}

.career-ui.is-workshop-exhibit .career-trend-tabs {
    padding: 5px;
    gap: 6px;
    background: #f1edf8;
    border-radius: 8px;
}

.career-ui.is-workshop-exhibit .career-trend-tab {
    min-height: 44px;
    border-radius: 6px;
    font-size: 18px;
    font-weight: 600;
    color: #3b2851;
    box-shadow: none;
}

.career-ui.is-workshop-exhibit .career-button,
.career-ui.is-workshop-exhibit .career-file-button,
.career-ui.is-workshop-exhibit .career-panel-body input,
.career-ui.is-workshop-exhibit .career-panel-body textarea,
.career-ui.is-workshop-exhibit .career-panel-body select {
    min-height: 44px;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.5;
    box-shadow: none;
}

.career-ui.is-workshop-exhibit .career-panel-body input,
.career-ui.is-workshop-exhibit .career-panel-body textarea,
.career-ui.is-workshop-exhibit .career-panel-body select {
    border: 1px solid #9f91b4;
    color: #231b32;
    background: #ffffff;
}

.career-ui.is-workshop-exhibit .career-panel-body input::placeholder,
.career-ui.is-workshop-exhibit .career-panel-body textarea::placeholder {
    color: #696173;
    opacity: 1;
}

.career-ui.is-workshop-exhibit .career-card,
.career-ui.is-workshop-exhibit .career-skill-card,
.career-ui.is-workshop-exhibit .career-trend-card,
.career-ui.is-workshop-exhibit .career-notice,
.career-ui.is-workshop-exhibit .career-trend-sampling,
.career-ui.is-workshop-exhibit .career-pet-card {
    border-radius: 10px;
    box-shadow: none;
}

.career-ui.is-workshop-exhibit .career-muted,
.career-ui.is-workshop-exhibit .career-trend-intro {
    color: #51495f;
    opacity: 1;
}

.career-ui.is-workshop-exhibit .career-button:active,
.career-ui.is-workshop-exhibit .career-file-button:active {
    transform: none;
}

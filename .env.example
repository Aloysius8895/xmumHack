# Copy this file to src/game/.env for local development.
# The main game reads its own .env; production can use server environment variables.
VITE_SERVER_URL=
VITE_ANALYTICS_TAG=
VITE_GAME_PUBLIC=1
VITE_COMPRESSED=
VITE_DAY_CYCLE_PROGRESS=
VITE_YEAR_CYCLE_PROGRESS=
VITE_WHISPERS_COUNT=30
VITE_MUSIC=1
VITE_LOG=
VITE_PLAYER_SPAWN=

# Career platform AI (server side only, never prefixed with VITE_ so it stays out of the browser)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# RunPod vLLM: set AI_PROVIDER=runpod after deployment.
# Base URL ends in /v1, without /chat/completions. Never use VITE_ for these.
# Example: https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1
RUNPOD_BASE_URL=
RUNPOD_API_KEY=
RUNPOD_MODEL=
RUNPOD_TIMEOUT_MS=240000
# deepseek connects directly to the official API. deepseek_direct is the separate AWS Lambda provider.
ANTHROPIC_API_KEY=
# 1 = canned answers without calling an AI provider (demo)
AI_MOCK=
# Optional override, default claude-opus-5-5 when using Anthropic directly.
CLAUDE_MODEL=
# Other explicit providers: bedrock, deepseek_direct (AWS), replit, anthropic.
# AWS storage can be used with AI_PROVIDER=deepseek; model calls then go directly to DeepSeek.
# Restart `npm run dev` after changing .env.
# AI_PROVIDER=bedrock
# Server-only Replit Secrets. Never prefix with VITE_.
AWS_BACKEND_URL=
AWS_BACKEND_TOKEN=
# Maximum time in milliseconds to poll an asynchronous AWS AI task.
AWS_AI_MAX_WAIT_MS=240000
# Replit AI Integrations: Replit sets AI_INTEGRATIONS_ANTHROPIC_API_KEY / _BASE_URL itself once enabled (paid plan).
# Optional model, default claude-opus-5 (Replit's list has no claude-opus-5-5)
REPLIT_MODEL=
# Secret for /api/integrations/* (job market workflow, WhatsApp / Telegram agent), empty = integrations disabled
INTEGRATION_TOKEN=
# Job market workflow fallback runner (n8n/market/run-local.mjs): RapidAPI key of JSearch and the game server URL
RAPIDAPI_KEY=
API_BASE_URL=
# Optional local crawler snapshot directory. Default server/data/crawler; off disables ingestion.
# CRAWLER_DATA_DIR=
MARKET_CRAWLER_URL=http://127.0.0.1:8788
MARKET_CRAWLER_TOKEN=
# PostgreSQL for saves and the accumulated market window (Replit: Database tool sets it). Empty = local files.
DATABASE_URL=
# Daily automatic collection time shown in the Trends panel, HH:MM Malaysia time; off = no schedule. n8n runs it.
CRAWL_SCHEDULE_MYT=08:00
# 0 = no browser-based platforms (cloud). The cloud start script sets it for the crawler itself.
CRAWLER_BROWSER_SOURCES=
# Configure the collection provider in ../crawler/.env with npm run crawler:setup.

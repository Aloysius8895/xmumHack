# Copy to .env and fill in. .env is git-ignored and the bot's agent is blocked from reading it.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (message @userinfobot to get it). The bot ignores everyone else.
TELEGRAM_USER_ID=

# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
